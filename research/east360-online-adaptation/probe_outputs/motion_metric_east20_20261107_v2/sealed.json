- VAL\u4f7f\u7528\u76f8\u540c\u53d6\u70b9\u548c\u91cd\u5efa\u89c4\u5219\uff0c\u8bad\u7ec3\u65f6\u4e0d\u8bfbVAL\u4fe1\u53f7\u6216\u7ed3\u5c40\uff1b\u5148\u4fdd\u5b58VAL\u6240\u6709\u9884\u6d4b\u540e\u8ba1\u5206\u3002\u5bf9\u6bd4\u65e0\u66f4\u65b0\u3001\u56fa\u5b9a\u6743\u91cd\u5dee\u5206\u68af\u5ea6\u3001\u5df2\u5b66\u5168\u5c40\u6743\u91cd\u3001\u5df2\u5b66\u6761\u4ef6\u6743\u91cd\uff1b\u6761\u4ef6\u6743\u91cd\u53e6\u62a525\u70b9\u5faa\u73af\u9519\u65f67\u70b9\u300121\u8fde\u7eed\u901a\u9053\u5faa\u73af\u9519\u914d1\u4f4d\u3001\u771f\u5b9e\u53d8\u5316\u53d6\u53cd\u4e09\u4e2a\u63a7\u5236\u3002\u6240\u6709\u975e\u96f6\u72b6\u6001\u5339\u914d\u5b9e\u9645\u53c2\u6570\u8303\u6570\uff1b\u96f6\u65b9\u5411\u5982\u5b9e\u8bb0\u5f55\uff0c\u4e0d\u4ee3\u586b\u3002\n- \u771f\u5b9e\u66f4\u65b0\u5728release\u70b9\u4e0e\u539f\u9759\u6001\u7684logit\u5dee\u4fdd\u6301\u5230release+16\u5f62\u6210\u6807\u91cf\u5f71\u5b50\u3002\u5b83\u4ecd\u501f\u7528\u4e86\u771f\u5b9e\u66f4\u65b0\u7684\u951a\u70b9\uff0c\u4ec5\u7528\u4e8e\u68c0\u9a8c\u66f4\u665a\u7684\u795e\u7ecf\u4f5c\u7528\uff0c\u4e0d\u662f\u4e00\u4e2a\u72ec\u7acb\u9884\u6d4b\u5668\u3002\u5f53\u524d\u53ea\u505a\u79bb\u7ebf\u7a97\u53e3\u8bca\u65ad\uff0c\u4e0d\u628a\u5b83\u5199\u6210\u5b8c\u6574\u6d41FPR\u6216TPR\u3002\n\n## \u51b3\u7b56\u4e0e\u56e0\u679c\u8fb9\u754c\n\n\u5148\u6838\u5bf9\u96f6\u72b6\u6001\u4e0e\u539f\u6a21\u578b\u3001\u5b9e\u9645\u5c42\u94a9\u5b50\u4e0e\u7f13\u5b58\u3001\u51bb\u7ed3\u53c2\u6570\u548c\u7b2c\u4e8c\u9636\u5143\u68af\u5ea6\u3002\u5931\u8d25\u5219\u4fee\u5b9e\u73b0\uff0c\u4e0d\u8bc4\u5206\u3002\u6e90VAL\u7684\u5b89\u5168\u548c\u53ca\u65f6\u5371\u9669\u4e24\u7ec4\u5747\u987b\u6539\u5584\uff0c\u4e14\u4e24\u7ec4\u7b49\u6743\u6548\u7528\u80dc\u56fa\u5b9a\u6743\u91cd\u3001\u5168\u5c40\u6743\u91cd\u3001\u4e24\u4e2a\u9519\u914d\u53ca\u7b49\u951a\u70b9\u5f71\u5b50\uff1b\u65e9\u671f\u8d1f\u4f8b\u4e0d\u80fd\u6076\u5316\uff0c\u624d\u8fdb\u5165\u540c\u534f\u8baeEAST\u5b8c\u6574\u6d41\u3002\u53d6\u53cd\u53ea\u4f5c\u8865\u5145\uff0c\u907f\u514d\u7528\u672c\u6765\u5bf9\u5411\u7684\u65b9\u5411\u5f53\u5145\u5206\u8bc1\u636e\u3002\n\n\u4e0d\u4ee5\u201c\u6bcf\u4e2a\u6848\u4f8b\u5fc5\u987b\u80dc\u8fc7\u4efb\u610f\u4e8b\u540e\u6807\u91cf\u6700\u4f18\u201d\u7b5b\u6389\u8bad\u7ec3\u6837\u672c\uff1b\u91c7\u7528\u9884\u5148\u5b9a\u4e49\u3001\u53ef\u56e0\u679c\u8ba1\u7b97\u7684\u540c\u951a\u70b9\u5bf9\u7167\u5728\u5168\u4f53\u6848\u4f8b\u4e0a\u6bd4\u8f83\u3002\u8fd9\u4e0d\u964d\u4f4eEAST\u7684\u6700\u7ec8\u9a8c\u6536\uff1a\u4ecd\u9700\u5b8c\u6574\u6d41\u3001\u76f8\u540c\u7236\u6a21\u578b/\u9608\u503c\u3001FPR\u22640.20\u7684\u72ec\u7acb\u70ae\u5185\u6536\u76ca\uff0c\u4ee5\u53ca\u540e\u7eed\u70ae\u95f4/\u8054\u5408\u6d88\u878d\u3002\u6570\u636e\u5747\u53c2\u4e0e\u5f00\u53d1\uff0c\u6ca1\u6709\u72ec\u7acb\u672a\u6765\u9a8c\u8bc1\u6216\u7269\u7406\u5b9a\u5f8b\u7ed3\u8bba\u3002\n\n## \u7b5b\u9009\u5931\u8d25\u540e\u7684\u5b9a\u4f4d\uff0c\u4e0d\u7528\u4e8e\u91cd\u65b0\u9009\u62e9\u5019\u9009\n\n\u5df2\u5b8c\u6210\u7684\u56fa\u5b9a256\u6b65\u5019\u9009\u6ca1\u6709\u901a\u8fc7VAL\u95e8\u69db\u3002\u4e0b\u4e00\u9879\u53ea\u5728\u76f8\u540c153\u4e2a\u5df2\u8bc4\u5206\u7a97\u53e3\u8ba1\u7b97\u7406\u60f3\u901a\u9053\u6743\u91cd\uff0c\u533a\u5206\u66f4\u65b0\u7a7a\u95f4\u4e0d\u8db3\u4e0e\u5b66\u4e60\u89c4\u5219\u672a\u5b66\u597d\uff1a\u56fa\u5b9a\u539f\u6a21\u578b\u548c\u5df2\u5230\u8fbe\u7684\u53d8\u5316\uff0c\u5bf9\u6bcf\u4e2a\u8fde\u7eed\u901a\u9053\u6c42\u7b2c\u4e00FFN\u4e34\u65f6\u53c2\u6570\u7684\u52bf\u68af\u5ea6\uff0c\u7ec4\u6210256\u00d721\u77e9\u9635\uff1b\u4ee5\u8bc4\u4ef7\u70b9\u7684\u5df2\u63ed\u793a\u771f\u5b9e\u98ce\u9669\u68af\u5ea6\u4f5c\u79bb\u7ebf\u76ee\u6807\uff0cSVD\u4fdd\u7559\u76f8\u5bf9\u6700\u5927\u5947\u5f02\u503c\u5927\u4e8e1e-4\u7684\u65b9\u5411\uff0c\u6c42\u6700\u5c0f\u4e8c\u4e58\u6743\u91cd\uff0c\u518d\u540c\u6bd4\u4f8b\u7f29\u5230\u7edd\u5bf9\u503c\u22642\u3002\u6309\u771f\u5b9e\u52bf\u91cd\u65b0\u6c42\u68af\u5ea6\u5e76\u6267\u884c\u540c\u8303\u65700.35\u7684\u5b9e\u9645\u66f4\u65b0\uff0c\u6bd4\u8f83\u5b9e\u9645\u98ce\u9669BCE\u548c\u540c\u951a\u70b9\u6807\u91cf\uff1b\u8bb0\u5f55\u6709\u6548\u79e9\u3001\u6295\u5f71\u548c\u7cfb\u6570\u6761\u4ef6\uff0c\u4e0d\u4ee5\u7ebf\u6027\u4ee3\u66ff\u771f\u5b9e\u524d\u5411\u3002\u8be5\u53cd\u4e8b\u5b9e\u4f7f\u7528\u672a\u6765\u7ed3\u5c40\u548c\u8bc4\u4ef7\u7a97\u53e3\uff0c\u4e0d\u662f\u7b56\u7565\u3001\u4e0d\u53c2\u4e0e\u8bad\u7ec3\uff0c\u4e5f\u4e0d\u6539\u5df2\u7ecf\u5931\u8d25\u7684\u6a21\u578b\u6216\u95e8\u69db\u3002\n\n## V2\uff1a\u53ea\u6539\u53d8\u6b65\u957f\u51e0\u4f55\uff0c\u62df\u5408\u524d\u9501\u5b9a\n\nV1\u7684153\u4e2a\u72b6\u6001\u51e0\u4e4e\u5168\u90e8\u7528\u6ee10.35\u8303\u6570\uff0c\u5fae\u5c0f\u975e\u96f6\u53cd\u9988\u4e5f\u4e0d\u80fd\u4ea7\u751f\u5c0f\u6b65\u3002V2\u4fdd\u7559\u76f8\u540c\u70b9\u4f4d\u3001\u521d\u59cb\u5316\u3001256\u6b65\u548c\u635f\u5931\uff0c\u53ea\u628a\u5355\u4f4d\u8303\u6570\u66f4\u65b0\u6539\u6210`-0.35*g / max(s, norm(g))`\uff0cs\u56fa\u5b9a\u4e3a\u540c\u4e00\u6279TRAIN1352\u4e2a\u4f8b\u5b50\u4e0a\u3001\u521d\u59cb\u56fa\u5b9a\u6743\u91cd\u771f\u5b9e\u53d8\u5316\u68af\u5ea6\u8303\u6570\u768490%\u5206\u4f4d\u6570\uff1b\u4e0d\u4ee5VAL\u51b3\u5b9as\u3002\u4f4e\u4e8e\u53c2\u8003\u5f3a\u5ea6\u65f6\u4fdd\u7559\u53d8\u5316\u5927\u5c0f\uff0c\u8d85\u8fc7\u53c2\u8003\u624d\u9650\u5e45\uff0c\u96f6\u68af\u5ea6\u4e25\u683c\u4e0d\u52a8\u3002\u6743\u91cd\u7f51\u7edc\u56e0\u800c\u80fd\u901a\u8fc7\u6743\u91cd\u6574\u4f53\u7f29\u5c0f\u6765\u63a7\u5236\u5e45\u5ea6\u3002\u9519\u914d\u63a7\u5236\u4ecd\u5339\u914d\u771f\u5b9e\u5019\u9009\u5b9e\u9645\u53c2\u6570\u8303\u6570\u3002\u53e6\u76ee\u5f55\u4fdd\u5b58V2\uff0c\u4e0d\u8986\u76d6\u6216\u5ba3\u79f0\u63a8\u7ffbV1\u5931\u8d25\uff1b\u540c\u6837\u7684VAL\u518d\u8bc4\u662f\u5f00\u53d1\uff0c\u4e0d\u662f\u65b0\u72ec\u7acb\u9a8c\u8bc1\u3002\u539f\u57fa\u6a21\u3001\u9884\u6d4b\u5934\u548cEAST\u6d41\u90fd\u4e0d\u53d8\u3002\n\n## V2\u5728\u65e2\u6709EAST20\u5386\u53f2\u7684\u5e94\u7528\u8bca\u65ad\n\nV2\u4e5f\u672a\u901a\u8fc7\u6e90VAL\u95e8\u69db\uff0c\u4e0d\u6269\u8dd1\u5b8c\u6574360\u3002\u53ea\u5728\u5df2\u7ecf\u5408\u6cd5\u63ed\u793a\u3001\u7528\u4e8e\u65e2\u6709\u8f93\u5165\u6620\u5c04\u768420\u70ae\u5386\u53f2\u4e0a\u5e94\u7528\u540c\u4e00\u51bb\u7ed3\u89c4\u5219\uff0c\u5224\u65ad\u662f\u5426\u6709\u76f8\u540c\u5931\u8d25\uff0c\u4e0d\u89c6\u4f5c\u664b\u7ea7\u6216\u6700\u521d20\u70ae\u7684\u90e8\u7f72\u91cd\u8bc4\u300220\u70ae8\u7834\u88c2/12\u5b89\u5168\uff0c\u7edf\u4e00\u7528\u5df2\u7ecf\u62df\u5408\u5b8c\u6210\u7684\u539f\u6620\u5c04\u5904\u7406\uff0c\u672a\u589e\u52a0\u6807\u7b7e\u9884\u7b97\u6216\u91cd\u65b0\u62df\u5408\u6a21\u578b\u3002\u5b89\u5168\u70ae\u4ecequery\u2265169\u5747\u5300\u53d65\u70b9\uff0c\u7834\u88c2\u70ae\u6309\u5df2\u7ed3\u675fHDF5\u7684250/150/100/60/35ms\u5404\u53d6\u6700\u8fd1\u3001\u8bef\u5dee\u22642ms\u7684\u70b9\uff1b\u7f3a\u5b8c\u6574\u5386\u53f2\u5219\u660e\u786e\u7f3a\u5e2d\u3002origin=query\u221242\uff0crelease=query\u221216\uff0c\u76ee\u680725\u70b9\u5728release\u4e4b\u524d\u5df2\u5230\u9f50\u3002\u6cbf\u7528V2\u5168\u90e8\u56fa\u5b9a\u3001\u5168\u5c40\u3001\u6761\u4ef6\u3001\u9519\u65f6\u3001\u901a\u9053\u9519\u914d\u3001\u53cd\u5411\u548c\u7b49\u951a\u70b9\u63a7\u5236\uff0c\u53ea\u62a5\u544a\u5c40\u90e8BCE\u548c\u5b9e\u9645\u72b6\u6001\u8303\u6570\uff0c\u4e0d\u6362\u7b97\u4e3a\u6574\u6d41TPR\u6216FPR\u3002\u53d6\u70b9\u548c\u8bc4\u5206\u53ef\u7528\u5386\u53f2\u7ed3\u5c40\uff0c\u751f\u6210\u66f4\u65b0\u7684\u51fd\u6570\u4e0d\u63a5\u6536\u5b83\u4eec\uff1b\u4e0d\u8bfb\u53d6\u540e340\u70ae\u3001EAST110\u6216J-TEXT TEST\u3002\n\n## V3\uff1a\u6e90\u539f\u751f\u6807\u7b7e\u6559\u5b66\u4e0e\u56fa\u5b9a125\u8f85\u52a9\u6559\u5b66\u7684\u914d\u5bf9\n\nV2\u5728EAST20\u4e5f\u672a\u6539\u5584\u3002125\u4e2a\u6e90\u8bad\u7ec3\u8f85\u52a9\u6b63\u4f8b\u53ea\u670911\u4e2a\u5c5e\u4e8e\u6e90\u539f\u751f\u6b63\u7a97\uff0c\u8fd9\u8bf4\u660e\u6b64\u524d\u8de8\u88c5\u7f6e\u5171\u7528\u8f85\u52a9\u63d0\u524d\u7a97\u662f\u4e00\u9879\u5f88\u5f3a\u7684\u4efb\u52a1\u5047\u8bbe\uff0c\u800c\u4e0d\u662f\u539f\u6807\u7b7e\u4e8b\u5b9e\u3002V3\u4fdd\u7559V2\u7684\u7f51\u7edc\u548c\u66f4\u65b0\u51e0\u4f55\uff0c\u5019\u9009origin\u4e0d\u53d8\uff0c\u4f46\u6e90\u57df\u6309\u81ea\u8eab\u7684`max(25ms,AdvancedTime)`\u3001\u4e25\u683c\u63d0\u524d>10ms\u5206\u7ec4\u5e76\u53d6\u70b9\uff0c\u5bb9\u7eb3\u539f\u5148\u88ab>30ms\u7b5b\u6389\u7684\u6e90\u6709\u6548\u6b63\u4f8b\u3002\u540c\u4e00\u6279\u6e90\u70b9\u3001\u540c\u4e00\u521d\u59cb\u5316\u548c256\u6b65\u65e5\u7a0b\u4e0b\uff0c\u5206\u522b\u8bad\u7ec3\u539f\u751f\u6807\u7b7e\u6761\u4ef6\u7f51\u7edc\u3001\u539f\u751f\u6807\u7b7e\u5168\u5c40\u7f51\u7edc\u3001\u56fa\u5b9a125ms\u8f85\u52a9\u6807\u7b7e\u6761\u4ef6\u7f51\u7edc\uff1b\u540e\u8005\u6545\u610f\u4fdd\u7559\u4e0d\u540c\u6807\u7b7e\u5b9a\u4e49\uff0c\u4e0d\u58f0\u79f0\u8bad\u7ec3\u6b63\u4f8b\u6570\u91cf\u4e5f\u5339\u914d\u3002\u8bb0\u5f55\u5404\u81c2\u5b9e\u9645\u6b63\u4f8b\u66dd\u5149\uff0c\u6bd4\u8f83\u7684\u662f\u4e24\u79cd\u5b8c\u6574\u6559\u5b66\u5b9a\u4e49\uff0c\u4e0d\u628a\u5dee\u5f02\u4ec5\u5f52\u56e0\u4e8e\u7269\u7406\u65f6\u6807\u3002\n\n\u6e90VAL\u6309\u539f\u751f\u6807\u7b7e\u4e0e>10ms\u68c0\u67e5\uff0c\u5404\u63a7\u5236\u7528\u76f8\u540c\u7a97\u53e3\u3002\u4e4b\u540e\u53ea\u5728\u65e2\u6709EAST20\u76f8\u540c100\u4e2a\u70b9\u4e0a\u5bf9\u6bd4\u4e24\u79cd\u51bb\u7ed3\u6559\u5b66\u7f51\u7edc\uff0cEAST\u4ecd\u7528125ms\u548c>30ms\uff0c\u7edd\u4e0d\u6539\u6210\u6e90\u57df\u95e8\u69db\u3002\u6ca1\u6709\u5728J-TEXT\u8fd0\u884c\u6301\u4e45\u5728\u7ebf\u5206\u652f\uff0c\u6ca1\u6709\u4fee\u6539\u5408\u683c\u57fa\u6a21\u3002\u4ecd\u9700\u6ee1\u8db3\u6e90\u7b5b\u9009\u548c\u5b8c\u6574EAST\u6d41\u9a8c\u6536\uff0c\u5c40\u90e8\u6539\u5584\u4e0d\u80fd\u66ff\u4ee3\u6700\u7ec8\u76ee\u6807\u3002\n"
  }
}
